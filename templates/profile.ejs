<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title> 
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&family=Press+Start+2P&family=Satisfy&display=swap" rel="stylesheet">
</head>
<body>

    <div id="background">
        <div id="gameTop">
            <button class="switchButtons" onclick="window.location.href='/game'">Game</button>
            <h2 id="gameTitle">Your Pokemon Profile!</h2>
            <button class="switchButtons" onclick="window.location.href='/leaderboard'">Leaderboard</button>
        </div>
        <div id="gameContainer">
            <div style="display: block; width: 100%">
                <button id="blueButton" onclick="window.location.href='/logout'"></button>
                <h3 id="pokedex"><%= email %></h3>
            </div>
            <img id="pokeImg" src="/images/pokeball.png" alt="No image found">
            <br>
            <div style="width:100%; display: flex;">
                <div id="guessElts">
                    <h2>Total Pokemon Guessed Correctly: <%= score %></h2>
                    <!--<h2>Current Pokedex Entries:</h2>-->
                </div>
            </div>
        </div>
    </div>
    <script src="/code.js"></script>
</body>
</html>