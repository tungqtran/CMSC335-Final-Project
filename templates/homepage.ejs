<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title> 
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&family=Press+Start+2P&family=Satisfy&display=swap" rel="stylesheet">
</head>

<body>
    <div id="background">
        <div id="gameContainer">
            <h1 id="gameTitle" style="text-align: center">Who's That Pokémon?</h1>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;">
                <a href="/register" class="switchButtons" style="display:flex; align-items:center; justify-content:center; background-color: lightblue; border-radius: 10px; text-decoration: none; font-family: 'Press Start 2P', system-ui; font-size: 0.5rem; color: black;">New Account</a>
                <a href="/login" class="switchButtons" style="display:flex; align-items:center; justify-content:center; background-color: rgb(68, 228, 68); border-radius: 10px; text-decoration: none; font-family: 'Press Start 2P', system-ui; font-size: 0.5rem; color: black;">Log In</a>
            </div>
        </div>
    </div>
</body>
</html>