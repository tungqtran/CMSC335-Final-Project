<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title> 
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&family=Press+Start+2P&family=Satisfy&display=swap" rel="stylesheet">
</head>
<body>
    <div id="background">
        <div id="gameTop">
            <button class="switchButtons" onclick="window.location.href='/profile'">Profile</button>
            <h2 id="gameTitle">Leaderboard!</h2>
            <button class="switchButtons" onclick="window.location.href='/game'">Game</button>
        </div>
        <div id="gameContainer">
            <div style="display: flex; width: 100%">
                <button id="blueButton" onclick="window.location.href='/logout'"></button>
                <h3 id="pokedex">Top Ten:</h2>
            </div>
            <div style="overflow: auto; height: 50%; width:80%; display: flex; background-color:white; border-radius: 10px; border-width: 8px; border-style: solid; border-color: lightgrey">
                <div>
                    <ol>
                        <% leaderboard.forEach(function(user) { %>
                            <li>
                                User: <%= user.email %> :
                                Score: <%= user.score %>
                            </li>
                            <br>
                        <% }) %>
                    </ol>
                </div>
            </div>
            <div style="width:100%; display: flex;">
                <div id="guessElts">
                    <br>
                    <img src="/images/trophy.png" style="width: 140px;">
                </div>
                <img id="controller" src="/images/controller.png">
            </div>
    </div>
    <script src="/code.js"></script>
</body>
</html>